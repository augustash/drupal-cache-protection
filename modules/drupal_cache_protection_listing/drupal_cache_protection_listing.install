<?php

/**
 * @file
 * Install / uninstall / requirements hooks.
 */

declare(strict_types=1);

use Drupal\drupal_cache_protection_listing\ListingSanityCheck;

/**
 * Implements hook_uninstall().
 */
function drupal_cache_protection_listing_uninstall(): void {
  \Drupal::state()->delete(ListingSanityCheck::COOLDOWN_KEY);
}

/**
 * Implements hook_requirements().
 *
 * Silence means healthy, which is hard to distinguish from "not working". The
 * status report is where someone looks after a report of missing content, so
 * say plainly whether anything has been caught recently and where to read the
 * detail.
 */
function drupal_cache_protection_listing_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $seen = \Drupal::state()->get(ListingSanityCheck::COOLDOWN_KEY, []);
  if (empty($seen)) {
    return [
      'drupal_cache_protection_listing' => [
        'title' => t('Cache Protection: Listing'),
        'value' => t('No empty-listing anomalies detected'),
        'severity' => REQUIREMENT_OK,
      ],
    ];
  }

  $latest = max(array_map('intval', $seen));
  $now = \Drupal::time()->getRequestTime();
  $formatted = \Drupal::service('date.formatter')->format($latest);

  // Entries are pruned when the next detection is written, so with nothing
  // further happening the count would sit at its high-water mark forever and
  // read as ongoing. Anything past the cooldown is history: report it, but
  // don't raise a warning about a problem that has stopped.
  if (($now - $latest) > ListingSanityCheck::COOLDOWN) {
    return [
      'drupal_cache_protection_listing' => [
        'title' => t('Cache Protection: Listing'),
        'value' => t('No anomalies since @time', ['@time' => $formatted]),
        'description' => t('An earlier empty listing was caught and kept out of the caches. Nothing has recurred since. See the drupal_cache_protection_listing log for the route, page and filters involved.'),
        'severity' => REQUIREMENT_OK,
      ],
    ];
  }

  return [
    'drupal_cache_protection_listing' => [
      'title' => t('Cache Protection: Listing'),
      'value' => t('@count listing(s) rendering empty while content exists', ['@count' => count($seen)]),
      'description' => t('Most recent: @time. Those responses are not being cached and anything already cached for them has been purged. See the drupal_cache_protection_listing log for the route, page and filters involved — that is what identifies the cause.', [
        '@time' => $formatted,
      ]),
      'severity' => REQUIREMENT_WARNING,
    ],
  ];
}
